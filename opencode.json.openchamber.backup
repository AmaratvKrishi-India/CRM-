{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "graft": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@nanonets/graft",
        "mcp"
      ],
      "enabled": true
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \".opencode/skills/ck/hooks/session-start.mjs\""
          }
        ]
      }
    ]
  }
}
