{
  "name": "amaratvkrishi-sales-crm",
  "version": "2.0.0",
  "description": "Amaratv Krishi Field Sales CRM — offline-first mobile CRM (React + Capacitor + Supabase)",
  "private": true,
  "scripts": {
    "dev": "vite",
    "dev:staging": "npm run verify:staging-config && vite --mode staging",
    "build": "tsc && vite build",
    "build:staging": "npm run verify:staging-config && tsc && vite build --mode staging",
    "verify:staging-config": "tsx scripts/verify-staging-config.ts",
    "preview": "vite preview",
    "test": "tsx scripts/run-tests.ts",
    "test:node": "tsx scripts/run-tests.ts",
    "test:vitest": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:type": "tsc --noEmit -p tests/types/tsconfig.json",
    "test:type:watch": "tsc --noEmit -p tests/types/tsconfig.json --watch",
    "test:bench": "vitest bench",
    "test:perf:bundle": "tsx scripts/bundle-analysis.ts",
    "verify": "tsx scripts/verify.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:all": "tsx scripts/run-all-tests.ts",
    "test:ci": "tsx scripts/ci-test-runner.ts",
    "test:e2e:accessibility": "playwright test e2e/accessibility.spec.ts --project=chromium",
    "test:e2e:visual": "playwright test e2e/visual-regression.spec.ts --project=chromium",
    "test:e2e:api": "playwright test e2e/api.spec.ts --project=chromium",
    "test:native:android": "maestro test e2e/maestro",
    "test:lighthouse": "npm run build && tsx scripts/lighthouse-test.ts"
  },
  "keywords": [
    "crm",
    "field-sales",
    "offline-first",
    "capacitor",
    "supabase"
  ],
  "author": "Amaratv Krishi India",
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.1",
    "@fontsource/inter": "^5.3.0",
    "@supabase/supabase-js": "^2.112.3",
    "clsx": "^2.1.1",
    "dexie": "^4.4.5",
    "lucide-react": "^1.33.0",
    "papaparse": "^5.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "read-excel-file": "^9.3.10",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^26.2.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.0.0",
    "autoprefixer": "^10.5.4",
    "axe-playwright": "^2.2.2",
    "commander": "^15.0.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "exceljs": "^4.4.0",
    "expect-type": "^1.0.0",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.0.0",
    "lighthouse": "^13.4.1",
    "postcss": "^8.5.26",
    "rollup-plugin-visualizer": "^6.0.0",
    "supabase": "^2.116.0",
    "tailwindcss": "^4.3.3",
    "tsd": "^0.31.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.0.0"
  },
  "tsd": {
    "spec": "tests/types/**/*.test-d.ts",
    "compilerOptions": {
      "strict": true,
      "noEmit": true
    }
  }
}
